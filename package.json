{
  "name": "teachers-platforma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Кабинет репетитора. Статический сайт на GitHub Pages; тесты и линт — только для разработки.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:architecture": "vitest run tests/architecture-guards.test.js",
