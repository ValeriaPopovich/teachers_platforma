{
  "name": "teachers-platforma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Кабинет репетитора. Статический сайт на GitHub Pages; тесты и линт — только для разработки.",
  "scripts": {
    "dev": "run-p styles:watch dev:server",
    "dev:server": "vite --host 127.0.0.1 --open",
    "build": "npm run styles:build && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:architecture": "vitest run tests/architecture-guards.test.js",
    "test:e2e": "playwright test",
    "validate:stage0": "node scripts/validate-stage0.mjs",
    "styles:build": "node scripts/build-styles.mjs",
    "styles:refactor-roots": "node scripts/refactor-scss-roots.mjs",
    "styles:watch": "sass --watch --no-source-map --style=expanded styles/entries/main.scss:assets/styles.css",
    "styles:check": "node scripts/build-styles.mjs --check",
    "lint": "run-p lint:js lint:styles",
    "lint:js": "eslint .",
    "lint:styles": "stylelint \"{styles,src,packages}/**/*.{scss,vue}\" --allow-empty-input",
    "lint:styles:fix": "stylelint \"{styles,src,packages}/**/*.{scss,vue}\" --allow-empty-input --fix",
    "format": "prettier --write \"**/*.{js,mjs,json,yml,yaml,scss,vue}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,yml,yaml,scss,vue}\"",
    "refactor:deps": "depcruise src packages assets --config dependency-cruiser.config.js",
    "refactor:unused": "knip --include files,dependencies",
    "refactor:check": "run-p refactor:deps refactor:unused",
    "check": "run-s format:check lint validate:stage0 test styles:check refactor:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "acorn": "^8.18.0",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "knip": "^6.32.1",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.26",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.3.3",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "vue": "^3.5.41"
  },
  "overrides": {
    "stylelint-config-recommended-vue": {
      "stylelint-config-html": "1.1.0"
    }
  }
}
