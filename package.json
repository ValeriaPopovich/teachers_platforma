    "validate:stage0": "node scripts/validate-stage0.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.0",
    "eslint": "^9.13.0",
    "globals": "^17.9.0",
    "prettier": "^3.3.3",
    "vitest": "^2.1.4"
  }
}
